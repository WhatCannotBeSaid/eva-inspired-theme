{
  "name": "eva-inspired-theme",
  "version": "1.0.0",
  "description": "EVA-Inspired-Theme / NERV 闸门 — a Neon Genesis Evangelion skin for DeepSeek Harness. Two fully designed modes: Title Card (light) and Central Dogma (dark). 55 measured tokens over one removable override layer, plus a wallpaper paint layer whose two surface alphas are solved against a WCAG contrast budget rather than picked by eye.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "plugin",
    "theme",
    "skin",
    "evangelion",
    "neon",
    "eva-inspired-theme"
  ],
  "license": "(MIT AND CC-BY-NC-SA-4.0 AND OFL-1.1)",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "LICENSE",
    "LICENSE-CC-BY-NC-SA-4.0.txt",
    "NOTICE",
    "README.md",
    "docs/preview-light.jpg",
    "docs/preview-dark.jpg",
    "docs/optimization-s1-s10.md",
    "src",
    "build",
    "tools/*.mjs"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node tools/build-client.mjs",
    "build:public": "node tools/build-client.mjs --mode public",
    "measure:resources": "node tools/measure-resources.mjs",
    "prepare": "node tools/build-client.mjs",
    "check": "node tools/build-client.mjs --check",
    "selfcheck": "node tools/selfcheck.mjs",
    "audit": "node tools/token-audit.mjs",
    "test": "node --test tools/runtime.test.mjs tools/build-contract.test.mjs",
    "verify": "node tools/verify.mjs",
    "verify:release": "node tools/verify.mjs --strict-evidence"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  }
}
